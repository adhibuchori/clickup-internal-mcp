# Copy this file to ".env" next to package.json, or, next to a compiled executable, to ".env" or
# "clickup-internal-mcp.env" (easier to create on Windows). Then fill it in.
# Never commit .env and never paste the token into a chat.

# Required: your personal ClickUp token (ClickUp → Settings → Apps → API tokens → Create token).
# Name the token "clickup-mcp" so you know what to revoke.
CLICKUP_API_TOKEN=

# Required: the workspace id, the number after the host in any ClickUp URL.
CLICKUP_WORKSPACE_ID=

# Optional: where the local cache lives. Default: ~/Library/Application Support/clickup-internal-mcp
# on macOS, %LOCALAPPDATA%\clickup-internal-mcp on Windows, ~/.local/share/clickup-internal-mcp else.
# CLICKUP_DATA_DIR=

# Optional: also write tracked docs as Markdown files (with their images) to this folder, for
# reading and git diff outside Claude.
# CLICKUP_MIRROR_DIR=

# Optional: drop cached content nobody has read or synced for this many days (default 30).
# CLICKUP_CACHE_TTL_DAYS=30

# Optional: traffic shaping toward ClickUp. Defaults keep traffic quiet, far below plan limits.
# CLICKUP_MAX_CONCURRENCY=8
# CLICKUP_MAX_RPM=300

# Optional: extra host suffixes images may be downloaded from (comma-separated). ClickUp's own
# attachment hosts are always allowed.
# CLICKUP_ASSET_HOSTS=

# Optional: debug | info | warn | error
# LOG_LEVEL=info
