{
  "name": "clickup-internal-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Local MCP server that lets any MCP client read a ClickUp workspace through your personal token: docs, tasks, comments and images, with a local full-text index of what you track.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "clickup-internal-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "doctor": "bun src/index.ts doctor",
    "purge": "bun src/index.ts purge",
    "spike": "bun scripts/spike/spike.ts",
    "setup": "bun scripts/setup/setup.ts",
    "build": "bun scripts/build/build.ts",
    "bench": "bun scripts/bench/bench.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage && node scripts/check/coverage-files.mjs",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src scripts .claude/hooks",
    "format": "oxfmt src scripts .claude/hooks",
    "format:check": "oxfmt --check src scripts .claude/hooks",
    "fl": "bun run format && bun run lint",
    "fl:ci": "bun run format:check && oxlint --type-aware --deny-warnings src scripts .claude/hooks",
    "check:comments": "node scripts/check/comment-style.mjs",
    "check:dead-code": "knip-bun",
    "check:folder-shape": "node scripts/check/folder-shape.mjs",
    "check:coverage-policy": "node scripts/check/coverage-policy.mjs",
    "check:mocks": "bun scripts/check/module-mocks.ts",
    "check:version": "bun scripts/check/version-sync.ts",
    "gates": "bash scripts/check/gates.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.18.0"
  }
}
